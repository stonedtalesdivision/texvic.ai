# ==============================================================================
# TEXVIC.AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core AI Providers
# Gemini 3.8 / Flash: Primary engine for script ideation, hook audits, and Studio TTS narration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: NVIDIA NIM / OpenRouter / Nemotron for local/alternative swarm agent intelligence
NEMOTRON_API_KEY=
NVIDIA_NIM_URL="https://integrate.api.nvidia.com/v1"
NEMOTRON_MODEL="nvidia/nemotron-3-super-120b-a12b"

# Security & App Configuration
TOKEN_ENCRYPTION_KEY=
APP_URL="https://app.texvic.tech"
PORT=3000
APP_TIMEZONE="Asia/Kolkata"

# Owner Dashboard Authentication (Set either plaintext or scrypt hash)
TEXVIC_OWNER_PASSWORD="your-strong-password"
TEXVIC_OWNER_PASSWORD_HASH=

# Media Processing & Stock Footage APIs
FFMPEG_PATH=ffmpeg
# Optional: Free Stock Video & Image API keys for authentic moving reel background footage
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Optional: Custom local font and Chrome executable overrides
FONT_PATH=
CHROME_PATH=

# Cloud Video Generation Engine
VIDEO_PROVIDER=ltx23-hf
VIDEO_WORKER_TOKEN=
MEDIA_SIGNING_KEY=

# Hosted LTX-2.3 Worker Configuration
LTX_SPACE=Lightricks/LTX-2-3
LTX_API_NAME=/generate_video
LTX_DURATION=3.0
LTX_ENHANCE_PROMPT=false
LTX_HIGH_RES=true
LTX_SEED=10

# Legacy Gemini/Veo Provider (Kept for provider compatibility)
VEO_MODEL=veo-3.1-generate-preview
VEO_RESOLUTION=720p

# Telegram Sentinel 24x7 Push Notifications & Remote Two-Way Control
# Connect your bot token and owner chat ID to receive published video alerts, leads, and command control
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_SURFER_SPRINTS=false

# Meta Graph API - Instagram Professional Account Connection
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_API_VERSION=v26.0

META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN="sarlx_meta_verify_token_2026"
INSTAGRAM_ACCOUNT_ID=
META_ACCESS_TOKEN=

# Facebook Multi-Destination Broadcasting (Simultaneous Reels Publishing)
# Broadcast reels simultaneously to your Facebook Business Page and Facebook Creator Profile
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_USER_ID=
FACEBOOK_USER_ACCESS_TOKEN=

# Cloudflare Tunnel / Public Reverse Proxy (Required for Meta Webhooks & Video Hosting)
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_APP_URL=
