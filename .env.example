# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 32-byte AES-256 key, hex encoded (64 characters). Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
PORT=3000
FFMPEG_PATH=ffmpeg

# Instagram Business Login / Graph API configuration
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_API_VERSION=v24.0

# Legacy Facebook Login variables (optional fallback)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN="sarlx_meta_verify_token_2026"
INSTAGRAM_ACCOUNT_ID=
META_ACCESS_TOKEN=
