# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

TOKEN_ENCRYPTION_KEY=

APP_URL="MY_APP_URL"
PORT=3000

TEXVIC_OWNER_PASSWORD_HASH=
FFMPEG_PATH=ffmpeg

# Cloud video engine
VIDEO_PROVIDER=ltx23-hf
VIDEO_WORKER_TOKEN=
MEDIA_SIGNING_KEY=

# Hosted LTX-2.3 worker
LTX_SPACE=Lightricks/LTX-2-3
LTX_API_NAME=/generate_video
LTX_DURATION=3.0
LTX_ENHANCE_PROMPT=false
LTX_HIGH_RES=true
LTX_SEED=10

# Legacy Gemini/Veo provider (kept for provider compatibility)
VEO_MODEL=veo-3.1-generate-preview
VEO_RESOLUTION=720p

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_API_VERSION=v26.0

META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN="sarlx_meta_verify_token_2026"
INSTAGRAM_ACCOUNT_ID=
META_ACCESS_TOKEN=
