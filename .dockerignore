# Ignore environment variables containing secrets
.env*
!.env.example

# Ignore runtime databases, browser cookies, and local session profile
data/
*.db
*.db-*
*.sqlite*

# Ignore scratch files and local test media
scratch/
temp_test.*
test_*.jpg
test_*.txt

# Ignore Git directory and logs
.git/
.github/
*.log

# Ignore Node.js build cache & dependencies (installed inside container via npm ci)
node_modules/
dist/
coverage/
.DS_Store
